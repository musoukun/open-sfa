# .env にコピーして値を入れる。.env は Git に含めない

# 認証の署名に使う秘密鍵。長いランダムな文字列にする
BETTER_AUTH_SECRET=
# アプリを開く URL。招待メールやパスワード再設定メールのリンクにも使う
BETTER_AUTH_URL=http://localhost:3099

# メール送信（SMTP）。SMTP_HOST を書かなければ、開発用の Mailpit（http://localhost:8025）に届く
# 例: Gmail なら SMTP_HOST=smtp.gmail.com / SMTP_PORT=465 / SMTP_USER=自分のアドレス / SMTP_PASS=アプリパスワード
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=open-sfa <no-reply@example.com>

# 任意。Google Meet の文字起こしを商談に取り込むときだけ使う
# Google Cloud で Meet REST API を有効にし、OAuth クライアント（ウェブアプリケーション）を作る
# リダイレクト URI には {BETTER_AUTH_URL}/api/auth/callback/google を登録する
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 任意。npm run seed:admin で最初の管理者をコマンドから作るときだけ使う
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# 任意。画面右下の「要望を送る」を使うときだけ設定する
# 要望は GITHUB_REPO（owner/repo）の Issue になる。トークンは fine-grained で、そのリポジトリの Issues: Read and write を付ける
GITHUB_TOKEN=
GITHUB_REPO=
# Issue ができたら Discord のチャンネルに知らせる。Bot をサーバーに招待し、チャンネルの「メッセージを送信」権限を与える
# チャンネル ID・サーバー ID は Discord の開発者モードで、右クリック →「ID をコピー」
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=